{
  "manifestVersion": 1,
  "package": {
    "id": "metaphlan",
    "name": "Taxonomic Profiling (MetaPhlAn)",
    "description": "Profile short shotgun reads from any source, with native and CAMI-format taxonomic profiles.",
    "version": "0.1.0",
    "provider": "SeqDesk",
    "website": "https://github.com/biobakery/MetaPhlAn"
  },
  "files": {
    "definition": "definition.json",
    "registry": "registry.json",
    "samplesheet": "samplesheet.yaml",
    "readme": "README.md",
    "parsers": []
  },
  "targets": {
    "supported": [
      "order",
      "study"
    ]
  },
  "sequencingCompatibility": {
    "readLengthClass": "short",
    "requireReadLengthEvidence": true,
    "readLayouts": [
      "single",
      "paired"
    ]
  },
  "inputs": [
    {
      "id": "reads",
      "scope": "sample",
      "source": "sample.reads",
      "required": true
    }
  ],
  "resources": [
    {
      "id": "marker-database",
      "label": "MetaPhlAn marker database",
