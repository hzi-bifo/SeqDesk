        "mpa_vJan26_CHOCOPhlAnSGB_202605.2.bt2l",
        "mpa_vJan26_CHOCOPhlAnSGB_202605.3.bt2l",
        "mpa_vJan26_CHOCOPhlAnSGB_202605.4.bt2l",
        "mpa_vJan26_CHOCOPhlAnSGB_202605.rev.1.bt2l",
        "mpa_vJan26_CHOCOPhlAnSGB_202605.rev.2.bt2l"
      ],
      "maxExtractedBytes": 64424509440,
      "fileSizes": {
        "mpa_vJan26_CHOCOPhlAnSGB_202605.pkl": 91701032,
        "mpa_vJan26_CHOCOPhlAnSGB_202605.1.bt2l": 7934175221,
        "mpa_vJan26_CHOCOPhlAnSGB_202605.2.bt2l": 10254270108,
