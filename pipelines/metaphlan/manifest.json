  },
  "outputs": [
    {
      "id": "taxonomic_profile",
      "scope": "sample",
      "destination": "run_artifact",
      "type": "artifact",
      "fromStep": "profile",
      "discovery": {
        "pattern": "profiles/*.metaphlan.tsv",
        "matchSampleBy": "filename"
      }
    },
    {
      "id": "cami_profile",
      "scope": "sample",
      "destination": "run_artifact",
      "type": "artifact",
      "fromStep": "profile",
      "discovery": {
        "pattern": "profiles/*.cami.profile",
        "matchSampleBy": "filename"
      }
    },
    {
      "id": "provenance",
      "scope": "sample",
      "destination": "run_artifact",
      "type": "artifact",
      "fromStep": "profile",
      "discovery": {
        "pattern": "profiles/*.provenance.json",
        "matchSampleBy": "filename"
      }
    }
  ],
  "schema_requirements": {
    "tables": [
      "Sample",
      "PipelineRun",
      "PipelineArtifact"
    ]
