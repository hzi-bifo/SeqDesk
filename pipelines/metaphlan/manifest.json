          "fileName": "mpa_vJan26_CHOCOPhlAnSGB_202605_bt2.tar",
          "url": "https://cmprod1.cibio.unitn.it/biobakery4/metaphlan_databases/bowtie2_indexes/mpa_vJan26_CHOCOPhlAnSGB_202605_bt2.tar",
          "bytes": 41742510080,
          "format": "tar",
          "checksum": { "algorithm": "md5", "value": "ac93e1e9c0829629266f5b6ab19c318d" }
