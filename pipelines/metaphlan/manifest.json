  "execution": {
    "type": "nextflow",
    "pipeline": "./workflow",
    "version": "0.1.0",
    "profiles": [
      "conda"
    ],
    "defaultParams": {
      "metaphlanDb": "",
      "metaphlanIndex": "",
      "skipUnclassifiedEstimation": false
    },
    "paramMap": {
      "metaphlanDb": "--db_dir",
      "metaphlanIndex": "--db_index",
      "skipUnclassifiedEstimation": "--skip_unclassified_estimation"
