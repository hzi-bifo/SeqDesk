{
  "manifestVersion": 1,
  "package": {
    "id": "fastqc",
    "name": "FastQC",
    "version": "0.1.0",
    "description": "Run FastQC quality control on linked FASTQ files in an order",
    "provider": "SeqDesk"
  },
  "files": {
    "definition": "definition.json",
    "registry": "registry.json",
    "samplesheet": "samplesheet.yaml",
    "readme": "README.md",
    "scripts": {
      "discoverOutputs": "scripts/discover-outputs.mjs"
    }
  },
  "targets": {
    "supported": [
      "order"
    ]
  },
  "inputs": [
    {
      "id": "reads",
      "scope": "sample",
      "source": "sample.reads",
      "required": true
    }
  ],
  "execution": {
    "type": "nextflow",
    "pipeline": "./workflow",
    "version": "0.1.0",
    "profiles": [
      "conda"
    ],
    "runtime": {
      "allowMacOsArmLocal": true
    },
    "defaultParams": {}
  },
  "outputs": [
    {
      "id": "sample_qc_reports",
      "result": { "kind": "run_artifact", "preview": { "label": "Original quality reports", "description": "The saved FastQC HTML report for each read file." } },
      "scope": "sample",
      "destination": "run_artifact",
      "type": "artifact",
      "fromStep": "fastqc",
      "discovery": {
        "pattern": "fastqc_reports/*_fastqc.html",
        "matchSampleBy": "filename"
      }
    },
    {
      "id": "sample_qc_data",
      "result": { "kind": "download", "preview": { "label": "Raw QC results", "description": "FastQC ZIP files for reuse in other tools.", "previewable": false } },
      "scope": "sample",
      "destination": "run_artifact",
      "type": "artifact",
      "fromStep": "fastqc",
      "discovery": {
        "pattern": "fastqc_reports/*_fastqc.zip",
        "matchSampleBy": "filename"
      }
    },
    {
      "id": "sample_fastqc_reads",
      "scope": "sample",
      "destination": "sample_reads",
      "type": "artifact",
      "fromStep": "fastqc",
      "writeback": {
        "target": "Read",
        "mode": "merge",
        "fields": {
          "fastqcReport1": "fastqcReport1",
          "fastqcReport2": "fastqcReport2",
          "readCount1": "readCount1",
          "readCount2": "readCount2",
          "avgQuality1": "avgQuality1",
          "avgQuality2": "avgQuality2"
        }
      },
      "discovery": {
        "pattern": "fastqc_reports/*_R1_fastqc.html",
        "matchSampleBy": "filename"
      }
    },
    {
      "id": "summary",
      "scope": "run",
      "destination": "run_artifact",
      "type": "artifact",
      "table": {
        "label": "FastQC quality summary",
        "description": "Read counts, mean Phred quality and FastQC PASS / WARN / FAIL check counts for R1 and R2. One row per sample; missing R2 values stay empty for single-end reads.",
        "tableKind": "sample-summary",
        "schemaId": "seqdesk.fastqc-summary",
        "schemaVersion": "1",
        "rowEntity": "sample",
        "columns": {
          "r1_pass": { "type": "number", "unit": "checks", "required": true },
          "r1_warn": { "type": "number", "unit": "checks", "required": true },
          "r1_fail": { "type": "number", "unit": "checks", "required": true },
          "r1_read_count": { "type": "number", "unit": "reads", "required": true },
          "r1_avg_quality": { "type": "number", "unit": "Phred", "required": true },
          "r2_pass": { "type": "number", "unit": "checks", "nullable": true },
          "r2_warn": { "type": "number", "unit": "checks", "nullable": true },
          "r2_fail": { "type": "number", "unit": "checks", "nullable": true },
          "r2_read_count": { "type": "number", "unit": "reads", "nullable": true },
          "r2_avg_quality": { "type": "number", "unit": "Phred", "nullable": true }
        },
        "format": "tsv",
        "sampleColumn": "sample_id",
        "columnLabels": {
          "r1_pass": "R1 passed checks",
          "r1_warn": "R1 warnings",
          "r1_fail": "R1 failed checks",
          "r1_read_count": "R1 reads",
          "r1_avg_quality": "R1 mean quality (Phred)",
          "r2_pass": "R2 passed checks",
          "r2_warn": "R2 warnings",
          "r2_fail": "R2 failed checks",
          "r2_read_count": "R2 reads",
          "r2_avg_quality": "R2 mean quality (Phred)"
        }
      },
      "fromStep": "fastqc",
      "discovery": {
        "pattern": "summary/fastqc-summary.tsv"
      }
    }
  ],
  "schema_requirements": {
    "tables": [
      "Read",
      "PipelineRun",
      "PipelineArtifact"
    ]
  },
  "ui": {
    "sampleResult": {
      "columnLabel": "FastQC",
      "emptyText": "Not generated",
      "layout": "columns",
      "values": [
        {
          "label": "R1 report",
          "path": "read.fastqcReport1",
          "whenPathExists": "read.file1",
          "format": "filename",
          "previewable": true
        },
        {
          "label": "R1 avg Q",
          "path": "read.avgQuality1",
          "whenPathExists": "read.file1"
        },
        {
          "label": "R2 report",
          "path": "read.fastqcReport2",
          "whenPathExists": "read.file2",
          "format": "filename",
          "previewable": true
        },
        {
          "label": "R2 avg Q",
          "path": "read.avgQuality2",
          "whenPathExists": "read.file2"
        }
      ]
    }
  }
}
