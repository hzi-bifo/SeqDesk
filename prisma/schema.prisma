generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  integrationAccounts IntegrationAccount[]
  id             String          @id @default(cuid())
  email          String          @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  /// Installation-level authorization. `role` remains as a rollback-compatible
  /// system-role mirror until every stored user and integration has migrated.
  systemRole     String          @default("MEMBER")
  role           String          @default("RESEARCHER")
  /// Sequencing-center responsibility, independent from installation administration.
  facilityWorkflowRole String     @default("REQUESTER")
  isActive        Boolean         @default(true)
  deactivatedAt   DateTime?
  isDemo         Boolean         @default(false)
  researcherRole String?
  institution    String?
  facilityName   String?
  notificationPreferences String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  departmentId   String?
  demoWorkspace  DemoWorkspace?  @relation("DemoWorkspaceResearcher")
  adminDemoWorkspace DemoWorkspace? @relation("DemoWorkspaceAdmin")
  usedInvite     AdminInvite?    @relation("InviteUser")
  createdInvites AdminInvite[]   @relation("InviteCreator")
  revokedInvites AdminInvite[]   @relation("InviteRevoker")
  orders         Order[]
  orderNotesEdited Order[]       @relation("OrderNotesEditor")
  sequencingFilesPublishedOrders Order[] @relation("OrderSequencingFilesPublisher")
  statusNotes    StatusNote[]
  studies          Study[]         @relation("StudyOwner")
  studyNotesEdited Study[]         @relation("StudyNotesEditor")
  tickets          Ticket[]
  ticketMessages TicketMessage[]
  pipelineRuns   PipelineRun[]
  pipelineResultSelectionsSelected PipelineResultSelection[] @relation("PipelineResultSelectedBy")
  inAppNotifications InAppNotification[]
  sequencingArtifactsCreated SequencingArtifact[] @relation("SequencingArtifactCreator")
  sequencingUploadsCreated   SequencingUpload[]   @relation("SequencingUploadCreator")
  backgroundWorkersStarted   BackgroundWorkerProcess[] @relation("BackgroundWorkerStartedBy")
  workbenchWorkspace WorkbenchWorkspace? @relation("WorkbenchWorkspaceOwner")
  workbenchImportJobsCreated WorkbenchImportJob[] @relation("WorkbenchImportJobCreator")
  exploreDatasetsCreated ExploreDataset[] @relation("ExploreDatasetCreator")
  exploreAnalysesCreated ExploreAnalysis[] @relation("ExploreAnalysisCreator")
  exploreRunsCreated ExploreAnalysisRun[] @relation("ExploreRunCreator")
  department     Department?     @relation(fields: [departmentId], references: [id])

  @@index([systemRole])
  @@index([systemRole, isActive])
}

model IntegrationAccount {
  id          String @id
  authority   String
  workspaceId String
  memberId    String
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([authority, workspaceId, memberId])
}

model IntegrationProjectLink {
  id          String @id
  authority   String
  workspaceId String
  projectId   String
  targetKind  String
  targetId    String
  createdBy   String

  @@unique([authority, workspaceId, projectId, targetKind, targetId], map: "IntegrationProjectLink_context_target_key")
}

/// An Explore scope (a "study" in Flow) that a collaboration workspace shares.
/// `projectId` is the workspace's project the study belongs to, empty for
/// team-wide studies. Every active member of the workspace may open the
/// scope; see resolveTargetAccess.
model IntegrationExploreScope {
  id          String   @id
  authority   String
  workspaceId String
  projectId   String   @default("")
  targetKey   String
  createdBy   String
  createdAt   DateTime @default(now())
  /// lab: every active member of the workspace; private: only ownerMemberId (My space).
  visibility    String @default("lab")
  ownerMemberId String @default("")

  @@unique([authority, workspaceId, targetKey], map: "IntegrationExploreScope_scope_key")
  @@index([authority, workspaceId, projectId])
}

model InAppNotification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String
  severity   String    @default("info")
  title      String
  body       String?
  linkPath   String?
  sourceType String
  sourceId   String?
  dedupeKey  String    @unique
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, archivedAt, readAt, createdAt])
  @@index([sourceType, sourceId])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Order {
  id               String       @id @default(cuid())
  dataOrigin       String       @default("facility")
  sourceMetadata   String?
  orderNumber      String       @unique
  name             String?
  generatedByE2E   Boolean      @default(false)
  status           String       @default("DRAFT")
  statusUpdatedAt  DateTime     @default(now())
  notes            String?
  notesEditedAt    DateTime?
  notesEditedById  String?
  sequencingFilesPublishedAt DateTime?
  sequencingFilesPublishedById String?
  numberOfSamples  Int?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  billingAddress   String?
  platform         String?
  instrumentModel  String?
  librarySelection String?
  libraryStrategy  String?
  librarySource    String?
  customFields     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  notesEditedBy    User?        @relation("OrderNotesEditor", fields: [notesEditedById], references: [id])
  sequencingFilesPublishedBy User? @relation("OrderSequencingFilesPublisher", fields: [sequencingFilesPublishedById], references: [id], onDelete: SetNull)
  samples          Sample[]
  sequencingArtifacts SequencingArtifact[]
  sequencingUploads   SequencingUpload[]
  sequencingRuns      SequencingRun[]
  streamRuns          StreamRun[]
  pipelineRuns      PipelineRun[]
  pipelineResultSelections PipelineResultSelection[]
  sampleset        Sampleset?
  statusNotes      StatusNote[]
  tickets          Ticket[]     @relation("TicketOrder")
}

model Study {
  id                 String        @id @default(cuid())
  title              String
  alias              String?
  description        String?
  generatedByE2E     Boolean       @default(false)
  checklistType      String?
  mixsVersion        Int?
  studyMetadata      String?
  readyForSubmission Boolean       @default(false)
  readyAt            DateTime?
  studyAccessionId   String?
  submitted          Boolean       @default(false)
  submittedAt        DateTime?
  testRegisteredAt   DateTime?
  notes              String?
  notesEditedAt      DateTime?
  notesEditedById    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             String
  samples            Sample[]
  cohortMembers      StudySample[]
  pipelineRuns       PipelineRun[]
  pipelineResultSelections PipelineResultSelection[]
  user               User          @relation("StudyOwner", fields: [userId], references: [id])
  notesEditedBy      User?         @relation("StudyNotesEditor", fields: [notesEditedById], references: [id])
  tickets            Ticket[]      @relation("TicketStudy")
  studyFormConfig    StudyFormConfig?
}

model Sampleset {
  id             String  @id @default(cuid())
  checklists     String
  selectedFields String?
  fieldOverrides String?
  sampleType     Int     @default(1)
  orderId        String  @unique
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Sample {
  id                    String     @id @default(cuid())
  sampleId              String
  sampleAlias           String?
  sampleTitle           String?
  sampleDescription     String?
  scientificName        String?
  taxId                 String?
  sampleAccessionNumber String?
  biosampleNumber       String?
  checklistData         String?
  checklistUnits        String?
  customFields          String?
  facilityStatus        String     @default("WAITING")
  facilityStatusUpdatedAt DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  orderId               String?
  studyId               String?
  assemblies            Assembly[] @relation("SampleAssemblies")
  preferredAssemblyId   String?    @unique
  preferredAssembly     Assembly?  @relation("PreferredAssembly", fields: [preferredAssemblyId], references: [id], onDelete: SetNull)
  bins                  Bin[]
  reads                 Read[]
  studyMemberships      StudySample[]
  sequencingRunSamples SequencingRunSample[]
  sequencingArtifacts   SequencingArtifact[]
  sequencingUploads     SequencingUpload[]
  streamIngestedFiles   StreamIngestedFile[]
  study                 Study?     @relation(fields: [studyId], references: [id])
  order                 Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Analysis membership never moves a sample or changes its owner/source study.
model StudySample {
  studyId    String
  sampleId   String
  groupLabel String?
  role       String @default("unassigned")
  metadata   Json?
  createdAt  DateTime @default(now())
  study      Study @relation(fields: [studyId], references: [id], onDelete: Cascade)
  sample     Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  @@id([studyId, sampleId])
  @@index([sampleId])
}

model Read {
  id                        String         @id @default(cuid())
  file1                     String?
  file2                     String?
  checksum1                 String?
  checksum2                 String?
  experimentAccessionNumber String?
  runAccessionNumber        String?
  readCount1                Int?
  readCount2                Int?
  avgQuality1               Float?
  avgQuality2               Float?
  fastqcReport1             String?
  fastqcReport2             String?
  sampleId                  String
  sequencingRunId           String?
  pipelineRunId             String?
  pipelineSources           String?
  dataClass                 String         @default("cleaned")
  dataClassSource           String         @default("legacy_assumed_cleaned")
  isActive                  Boolean        @default(true)
  supersededByReadId        String?
  classifiedAt              DateTime?
  classifiedById            String?
  classificationNote        String?
  sequencingRun             SequencingRun? @relation(fields: [sequencingRunId], references: [id])
  pipelineRun               PipelineRun?   @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  sample                    Sample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@index([sampleId, isActive])
  @@index([dataClass])
  @@index([supersededByReadId])
}

model SequencingRun {
  id             String    @id @default(cuid())
  runId          String
  runName        String?
  platform       String?
  instrument     String?
  runDate        DateTime?
  folderPath     String?
  q30Score       Float?
  clusterDensity Float?
  passFilterPct  Float?
  totalReads     Int?
  totalBases     BigInt?
  multiQcReport  String?
  demuxStats     String?
  runParameters  String?
  orderId        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reads          Read[]
  samples        SequencingRunSample[]
  sequencingArtifacts SequencingArtifact[]

  @@unique([orderId, runId])
  @@index([orderId])
  @@index([runDate])
}

model SequencingRunSample {
  id               String        @id @default(cuid())
  sequencingRunId  String
  sampleId         String
  barcode          String?
  customFields     String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sequencingRun    SequencingRun @relation(fields: [sequencingRunId], references: [id], onDelete: Cascade)
  sample           Sample        @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sequencingRunId, sampleId])
  @@unique([sequencingRunId, barcode])
  @@index([sampleId])
}

model StreamRun {
  id            String              @id @default(cuid())
  orderId       String
  minknowRunId  String?
  flowCellId    String?
  deviceId      String?
  outputDir     String
  status        String              @default("ACTIVE")
  totalBases    BigInt              @default(0)
  totalReads    Int                 @default(0)
  barcodeMap    String?
  startedAt     DateTime            @default(now())
  lastSeenAt    DateTime            @updatedAt
  stoppedAt     DateTime?
  monitorId     String?
  heartbeatAt   DateTime?
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        StreamRunEvent[]
  ingestedFiles StreamIngestedFile[]

  @@index([orderId, status])
  @@index([status, heartbeatAt])
}

// Tracks every FASTQ file ingested into a stream run, with a unique constraint
// on (streamRunId, filePath) so chokidar re-emits (rename, atomic-write,
// duplicate add/change events) cannot double-count reads. The stream-monitor
// upserts here BEFORE incrementing StreamRun totals; if the upsert was a
// no-op (file already present), it skips the increment.
model StreamIngestedFile {
  id          String    @id @default(cuid())
  streamRunId String
  sampleId    String?
  filePath    String
  barcode     String?
  size        Int       @default(0)
  reads       Int       @default(0)
  bases       BigInt    @default(0)
  ingestedAt  DateTime  @default(now())
  streamRun   StreamRun @relation(fields: [streamRunId], references: [id], onDelete: Cascade)
  sample      Sample?   @relation(fields: [sampleId], references: [id], onDelete: SetNull)

  @@unique([streamRunId, filePath])
  @@index([streamRunId, ingestedAt])
  @@index([sampleId, ingestedAt])
}

model StreamRunEvent {
  id          String    @id @default(cuid())
  streamRunId String
  seq         Int       @default(autoincrement())
  ts          DateTime  @default(now())
  kind        String
  payload     String?
  streamRun   StreamRun @relation(fields: [streamRunId], references: [id], onDelete: Cascade)

  @@index([streamRunId, seq])
  @@index([streamRunId, ts])
}

model BackgroundWorkerProcess {
  id           String    @id @default(cuid())
  name         String
  pid          Int
  startedAt    DateTime  @default(now())
  startedById  String?
  status       String    @default("RUNNING")
  stoppedAt    DateTime?
  exitCode     Int?
  logPath      String
  lastErrorMsg String?
  startedBy    User?     @relation("BackgroundWorkerStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([name, status])
  @@index([name, startedAt])
}

model SequencingArtifact {
  id             String         @id @default(cuid())
  orderId        String
  sampleId       String?
  sequencingRunId String?
  stage          String
  artifactType   String
  source         String
  visibility     String         @default("facility")
  path           String
  originalName   String
  size           BigInt?
  checksum       String?
  mimeType       String?
  metadata       String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sample         Sample?        @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  sequencingRun  SequencingRun? @relation(fields: [sequencingRunId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("SequencingArtifactCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, stage])
  @@index([sampleId, stage])
  @@index([sequencingRunId])
}

model SequencingUpload {
  id               String   @id @default(cuid())
  orderId          String
  sampleId         String?
  targetKind       String
  targetRole       String
  originalName     String
  tempPath         String
  finalPath        String?
  expectedSize     BigInt
  receivedSize     BigInt   @default(0)
  status           String   @default("PENDING")
  checksumProvided String?
  checksumComputed String?
  mimeType         String?
  metadata         String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sample           Sample?  @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  createdBy        User     @relation("SequencingUploadCreator", fields: [createdById], references: [id])

  @@index([orderId, status])
  @@index([sampleId, status])
}

model Assembly {
  id                     String       @id @default(cuid())
  assemblyName           String?
  assemblyFile           String?
  assemblyAccession      String?
  sampleId               String
  sample                 Sample       @relation("SampleAssemblies", fields: [sampleId], references: [id], onDelete: Cascade)
  preferredBySample      Sample?      @relation("PreferredAssembly")
  // Track which pipeline created this assembly
  createdByPipelineRunId String?
  createdByPipelineRun   PipelineRun? @relation(fields: [createdByPipelineRunId], references: [id])

  // Idempotency: one assembly per (run, sample, file). Concurrent resolution
  // (weblog workflow_complete + monitor/sync finalize) must not double-create.
  @@unique([createdByPipelineRunId, sampleId, assemblyFile])
}

model Bin {
  id                     String       @id @default(cuid())
  binName                String?
  binAccession           String?
  binFile                String?
  completeness           Float?
  contamination          Float?
  sampleId               String
  sample                 Sample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  // Track which pipeline created this bin
  createdByPipelineRunId String?
  createdByPipelineRun   PipelineRun? @relation(fields: [createdByPipelineRunId], references: [id])

  // Idempotency: one bin per (run, sample, file). Concurrent resolution must not
  // double-create.
  @@unique([createdByPipelineRunId, sampleId, binFile])
}

// ============================================================================
// PIPELINE SYSTEM
// ============================================================================

// Pipeline configuration (enabled/disabled + settings per pipeline type)
model PipelineConfig {
  id         String   @id @default(cuid())
  pipelineId String   @unique // 'mag', 'submg', 'fastqc'
  enabled    Boolean  @default(false)
  config     String? // JSON: pipeline-specific settings
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Individual pipeline execution record
model PipelineRun {
  id         String @id @default(cuid())
  runNumber  String @unique // MAG-20240126-001
  pipelineId String // 'mag', 'submg', 'fastqc'
  status     String @default("pending") // pending, queued, running, completed, failed, cancelled
  targetType String @default("study") // study, order

  // Configuration snapshot at run time
  config         String? // JSON
  inputSampleIds String? // JSON array of sample IDs selected for this run

  // Input - which study this run is for
  studyId String?
  study   Study?  @relation(fields: [studyId], references: [id])
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  // Execution details
  runFolder   String? // Path to run directory
  queueJobId  String? // SLURM job ID or task queue ID
  executionMode String? // resolved execution target: local, slurm
  executionProfile String? // JSON snapshot of non-secret execution policy used for this run
  progress    Int? // 0-100
  currentStep String? // "Running MEGAHIT..."

  // Timing
  queuedAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  lastEventAt  DateTime?
  lastWeblogAt DateTime?
  lastTraceAt  DateTime?
  statusSource String? // weblog, trace, process, launcher

  // Logs (stored as paths for large outputs)
  outputPath String? // Path to stdout file
  errorPath  String? // Path to stderr file
  outputTail String? // Last ~100 lines of output for quick preview
  errorTail  String? // Last ~100 lines of error

  // Results summary
  results String? // JSON summary of outputs

  // Queue tracking (SLURM/local)
  queueStatus    String? // RUNNING, PENDING, etc.
  queueReason    String?
  queueUpdatedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Who started this run
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Track outputs created by this run
  assembliesCreated Assembly[]
  binsCreated       Bin[]
  readsCreated      Read[]
  steps             PipelineRunStep[]
  events            PipelineRunEvent[]
  artifacts         PipelineArtifact[]
  selectedResultSelections PipelineResultSelection[] @relation("SelectedPipelineResultRun")

  @@index([studyId])
  @@index([orderId])
  @@index([targetType])
}

// Individual step within a pipeline run (for DAG visualization)
model PipelineRunStep {
  id            String      @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  stepId        String // e.g., "FASTQC", "MEGAHIT", "METABAT2" - from Nextflow process names
  stepName      String? // Human-readable name
  status        String      @default("pending") // pending, running, completed, failed, skipped
  startedAt     DateTime?
  completedAt   DateTime?
  outputPath    String?
  errorPath     String?
  outputTail    String? // Last lines of output
  errorTail     String? // Last lines of error

  @@unique([pipelineRunId, stepId])
}

// Event feed for pipeline runs (weblog/trace/queue updates)
model PipelineRunEvent {
  id            String      @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  eventType     String
  processName   String?
  stepId        String?
  status        String?
  message       String?
  payload       String? // JSON (trimmed)
  source        String? // weblog, trace, queue, process
  occurredAt    DateTime    @default(now())

  @@index([pipelineRunId, occurredAt])
}

// Artifacts produced by pipeline runs (files, reports, etc.)
model PipelineArtifact {
  id               String       @id @default(cuid())
  type             String // "reads", "assembly", "bins", "qc_report", "alignment"
  name             String? // Display name
  path             String // Absolute or relative path to artifact
  checksum         String? // MD5 or SHA256
  size             BigInt? // File size in bytes
  outputId         String? // Manifest output id, when resolved from a package output
  studyId          String?
  sampleId         String?
  pipelineRunId    String?
  pipelineRun      PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  producedByStepId String? // Which step produced this
  metadata         String? // JSON for tool-specific info
  createdAt        DateTime     @default(now())

  // Idempotency: one artifact per (run, path). Concurrent resolution (weblog
  // workflow_complete + monitor/sync finalize) must not double-create.
  @@unique([pipelineRunId, path])
  @@index([outputId])
}

// Explicit final-result selection for one study/order target and pipeline.
model PipelineResultSelection {
  id            String      @id @default(cuid())
  pipelineId    String
  targetKey     String // study:<id> or order:<id>
  studyId       String?
  orderId       String?
  selectedRunId String      @unique
  selectedRun   PipelineRun @relation("SelectedPipelineResultRun", fields: [selectedRunId], references: [id], onDelete: Cascade)
  selectedById  String?
  selectedBy    User?       @relation("PipelineResultSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)
  study         Study?      @relation(fields: [studyId], references: [id], onDelete: Cascade)
  order         Order?      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  selectedAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([pipelineId, targetKey])
  @@index([studyId])
  @@index([orderId])
  @@index([selectedById])
}

// ============================================================================
// WORKBENCH DATA IMPORTS
// ============================================================================

model WorkbenchWorkspace {
  id        String   @id @default(cuid())
  name      String   @default("Private Workbench")
  ownerId   String   @unique
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User                         @relation("WorkbenchWorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  datasets   WorkbenchWorkspaceDataset[]
  importJobs WorkbenchImportJob[]
  analyses   WorkbenchAnalysis[]

  @@index([ownerId])
}

model WorkbenchAnalysis {
  id          String   @id @default(cuid())
  workspaceId String
  name        String   @default("Untitled analysis")
  description String?
  canvas      String
  revision    Int      @default(1)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  WorkbenchWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importJobs WorkbenchImportJob[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, isDefault])
}

model WorkbenchDataset {
  id             String   @id @default(cuid())
  providerId     String
  cacheKey       String   @unique
  name           String
  description    String?
  sourceType     String
  sourceMetadata String?
  storagePath    String?
  sizeBytes      BigInt?
  checksumSha256 String?
  genomeCount    Int?
  status         String   @default("ready")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspaces WorkbenchWorkspaceDataset[]
  importJobs  WorkbenchImportJob[]

  @@index([providerId])
  @@index([status])
}

model WorkbenchWorkspaceDataset {
  id                   String   @id @default(cuid())
  workspaceId          String
  datasetId            String
  createdByImportJobId String?
  linkedAt             DateTime @default(now())

  workspace          WorkbenchWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataset            WorkbenchDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdByImportJob WorkbenchImportJob? @relation(fields: [createdByImportJobId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, datasetId])
  @@index([datasetId])
  @@index([createdByImportJobId])
}

model WorkbenchImportJob {
  id              String   @id @default(cuid())
  workspaceId     String
  providerId      String
  status          String   @default("queued")
  phase           String?
  request         String
  preview         String?
  progress        Int?
  logPath         String?
  targetPath      String?
  error           String?
  createdById     String
  resultDatasetId String?
  analysisId      String?
  analysisNodeId  String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       WorkbenchWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("WorkbenchImportJobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  resultDataset   WorkbenchDataset?  @relation(fields: [resultDatasetId], references: [id], onDelete: SetNull)
  analysis        WorkbenchAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  workspaceLinks  WorkbenchWorkspaceDataset[]

  @@index([workspaceId, createdAt])
  @@index([providerId])
  @@index([status])
  @@index([createdById])
  @@index([resultDatasetId])
  @@index([analysisId])
}

model StatusNote {
  id        String   @id @default(cuid())
  noteType  String   @default("INTERNAL")
  content   String
  createdAt DateTime @default(now())
  orderId   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SiteSettings {
  id                         String   @id @default("singleton")
  siteName                   String   @default("SeqDesk")
  logoUrl                    String?
  faviconUrl                 String?
  primaryColor               String   @default("#3b82f6")
  secondaryColor             String   @default("#1e40af")
  contactEmail               String?
  helpText                   String?
  enaUsername                String?
  enaPassword                String?
  enaTestMode                Boolean  @default(true)
  dataBasePath               String?
  postSubmissionInstructions String?
  modulesConfig              String?
  extraSettings              String?
  updatedAt                  DateTime @updatedAt
}

model OrderFormConfig {
  id              String   @id @default("singleton")
  schema          String
  coreFieldConfig String
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Per-study questionnaire schema, used only when the `dynamic-studies` module is
// enabled. 1:1 with Study (like Sampleset is 1:1 with Order). `fields`/`groups`
// are JSON-string arrays of FormFieldDefinition/FormFieldGroup. When no row
// exists for a study, loaders fall back to the global study form
// (SiteSettings.extraSettings.studyFormFields/studyFormGroups).
model StudyFormConfig {
  id              String   @id @default(cuid())
  studyId         String   @unique
  fields          String
  groups          String
  defaultsVersion Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  study           Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
}

model Submission {
  id               String   @id @default(cuid())
  submissionType   String
  status           String   @default("PENDING")
  xmlContent       String?
  response         String?
  accessionNumbers String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  entityType       String
  entityId         String
}

model DemoWorkspace {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String   @unique
  adminUserId String?  @unique
  seedVersion Int
  lastSeenAt  DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation("DemoWorkspaceResearcher", fields: [userId], references: [id])
  adminUser   User?    @relation("DemoWorkspaceAdmin", fields: [adminUserId], references: [id])

  @@index([expiresAt])
}

model Ticket {
  id                 String          @id @default(cuid())
  subject            String
  status             String          @default("OPEN")
  priority           String          @default("NORMAL")
  lastUserMessageAt  DateTime?
  lastAdminMessageAt DateTime?
  userReadAt         DateTime?
  adminReadAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  closedAt           DateTime?
  userId             String
  orderId            String?
  studyId            String?
  user               User            @relation(fields: [userId], references: [id])
  order              Order?          @relation("TicketOrder", fields: [orderId], references: [id])
  study              Study?          @relation("TicketStudy", fields: [studyId], references: [id])
  messages           TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  userId    String
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model AdminInvite {
  id          String    @id @default(cuid())
  // Legacy plaintext invitation secret. New invitations leave this null and
  // persist only codeDigest; retained temporarily so still-active pre-upgrade
  // invitations can be redeemed until they expire or are revoked.
  code        String?   @unique
  codeDigest  String?   @unique
  email       String?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  createdById String
  targetSystemRole String @default("MEMBER")
  targetFacilityWorkflowRole String    @default("REQUESTER")
  usedAt      DateTime?
  usedById    String?   @unique
  revokedAt   DateTime?
  revokedById String?
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id])
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  revokedBy   User?     @relation("InviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([createdById, usedAt, revokedAt])
}

// ---------------------------------------------------------------------------
// Explore: datasets assembled from study/sequencing/pipeline data, curation
// edits applied at query time, code-visible analyses with managed runs.
// Scope is a targetKey (study:<id> | order:<id> | workspace:<id>), the same
// shape PipelineResultSelection uses.
// ---------------------------------------------------------------------------

model ManagedFile {
  id             String   @id @default(cuid())
  targetKey      String
  originalName   String
  storagePath    String   @unique
  mimeType       String
  sizeBytes      BigInt
  checksumSha256 String
  createdById    String
  createdAt      DateTime @default(now())
  description    String?
  tags           String[]  @default([])
  sensitivity    String    @default("standard")
  removedAt      DateTime?
  removedById    String?
  createdByMemberId String? // the collaboration member who uploaded it through the integration API

  datasets ExploreDataset[]
  reports  ExploreReportFile[]

  @@index([targetKey, createdAt])
}

model ExploreReportFile {
  reportId String
  fileId   String
  linkedAt DateTime @default(now())

  report ExploreReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  file   ManagedFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([reportId, fileId])
  @@index([fileId])
}

model ExploreDataset {
  id               String   @id @default(cuid())
  targetKey        String
  kind             String   // samples | sequencing | pipeline-table | external | derived
  tableKind        String?  // e.g. taxon-profile-long
  sourceFileId     String?
  sourceFile       ManagedFile? @relation(fields: [sourceFileId], references: [id], onDelete: Restrict)
  name             String
  description      String?
  sensitivity      String   @default("standard") // standard | pseudonymous | clinical
  roles            String?  // JSON column -> role map
  sourceConfig     String?  // JSON builder configuration (pipeline id, output id, run ids, import options)
  currentVersionId String?  @unique
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy User                    @relation("ExploreDatasetCreator", fields: [createdById], references: [id])
  versions  ExploreDatasetVersion[]
  edits     ExploreDatasetEdit[]

  @@index([targetKey, kind])
  @@index([createdById])
}

model ExploreDatasetVersion {
  id          String   @id @default(cuid())
  datasetId   String
  number      Int
  contentHash String
  schema      String   // JSON: columns with types and roles
  rowCount    Int
  provenance  String   // JSON: source entities, runs, artifacts, files
  storagePath String?  // immutable TSV + schema.json copy
  buildSource String   // auto | manual | import | analysis-run
  createdById String?
  createdAt   DateTime @default(now())

  dataset ExploreDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  rows    ExploreDatasetRow[]

  @@unique([datasetId, number])
  @@index([datasetId, contentHash])
}

model ExploreDatasetRow {
  id        Int     @id @default(autoincrement())
  versionId String
  rowIndex  Int
  sampleId  String?
  subjectId String?
  key       String? // secondary key, e.g. taxon id or run id
  data      Json

  version ExploreDatasetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, rowIndex])
  @@index([versionId, sampleId])
  @@index([versionId, subjectId])
  @@index([versionId, key])
}

// Curation edits never touch a version; they are applied at query time.
model ExploreDatasetEdit {
  id          String    @id @default(cuid())
  datasetId   String
  kind        String    // cell | row-flag | row-exclude | column-add | column-hide
  target      String    // JSON {rowKey?, column?}
  value       String?   // JSON
  reason      String?
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?

  dataset ExploreDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, createdAt])
}

// Named lists (pathogen tiers, flora, artifacts) per scope, editable at runtime.
model ExploreProject {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model ExploreReport {
  id          String    @id @default(cuid())
  targetKey   String
  title       String
  blocks      Json      // ordered report blocks: text (markdown), figure (analysis + figure name), table (dataset), ...
  settings    Json?     // page-level settings: filters over table columns that every block honours
  createdById String
  publishedAt DateTime? // reserved for sharing: set when a share link is issued
  shareToken  String?   @unique
  shareMode   String    @default("link") // link: anyone with the link | named: invited people who sign in through the collaboration server
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  analyses ExploreAnalysis[] // the analysis steps that belong to this report
  files    ExploreReportFile[]

  @@index([targetKey])
}

model ExploreCurationList {
  id        String   @id @default(cuid())
  targetKey String
  listId    String
  label     String
  role      String   // pathogen | flora | artifact
  site      String?
  tier      String?
  color     String?
  entries   String   // JSON [{name, note, refs}]
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([targetKey, listId])
}

model ExploreEnvironment {
  id         String    @id @default(cuid())
  name       String    @unique // seqdesk-explore-python
  spec       String    // conda environment YAML
  specHash   String
  status     String    @default("missing") // missing | building | ready | failed
  prefixPath String?
  builtAt    DateTime?
  lastError  String?
  // The explicit lock (conda list --explicit --md5) digest, cached per specHash.
  lockDigest      String?
  lockSpecHash    String?
  languageVersion String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// A flow: one canvas of analysis steps over a scope's tables, exploring one
// question. Reports cite the outputs of any flow in their scope.
model ExploreFlow {
  id          String   @id @default(cuid())
  targetKey   String
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // The recipe: a revision counter bumped on every structural change, numbered
  // runs of the whole recipe, the run whose results are shown, the Expert
  // layout and the one value the flow is known by.
  recipeRevision    Int     @default(0)
  runCounter        Int     @default(0)
  trialCounter      Int     @default(0)
  currentRunId      String?
  layout            Json?   // {nodes:{<id>:{x,y}}, groups:[{id,name,stepIds,collapsed}], snap}
  headlineValue     String? // <stepId>.<metricKey>
  createdByMemberId String?
  conversationVersion Int   @default(0) // the seq of the newest conversation turn

  analyses  ExploreAnalysis[] // the analysis steps on this flow's canvas
  revisions ExploreFlowRevision[]
  runs      ExploreFlowRun[]
  proposals ExploreStepProposal[]
  turns     ExploreFlowTurn[]
  questions ExploreFlowQuestion[]

  @@index([targetKey])
}

// One turn of a flow's shared conversation (sheet 46), seen by everyone who
// can open the flow. Assistant turns are written by the web client, which runs
// the model through the collaboration server; SeqDesk never calls a model.
model ExploreFlowTurn {
  id                  String   @id @default(cuid())
  flowId              String
  seq                 Int      // 1, 2, ... per flow; the conversation version after this turn
  kind                String   // goal | proposal | question | answer | revision | message | check
  authorKind          String   // person | assistant
  authorUserId        String
  authorMemberId      String?
  authorName          String?
  requestedByMemberId String?  // assistant turns: the member whose request it answers
  stepIds             String[] @default([])
  text                String?
  data                Json?    // kind-specific: proposalIds, question, answer, revision, check
  model               String?
  inputsLabel         String?
  status              String?  // assistant turns: working | done | stopped | failed
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  flow ExploreFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, seq])
}

// A question the assistant asked in the conversation; one answer closes it.
model ExploreFlowQuestion {
  id                 String    @id @default(cuid())
  flowId             String
  turnId             String    @unique
  stepId             String?
  text               String
  options            Json      @default("[]") // [{id, label}]
  answeredByUserId   String?
  answeredByMemberId String?
  answeredAt         DateTime?
  answerTurnId       String?
  answerOptionId     String?
  answerText         String?
  createdAt          DateTime  @default(now())

  flow ExploreFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
}

// A snapshot of a flow's recipe, written with every structural change.
model ExploreFlowRevision {
  id                String   @id @default(cuid())
  flowId            String
  number            Int
  steps             Json     // [{analysisId, revisionId, position, laneKind, laneOf}]
  message           String?
  createdById       String
  createdByMemberId String?
  createdAt         DateTime @default(now())

  flow ExploreFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, number])
}

// One numbered run of a flow's whole recipe (or of its out-of-date or chosen
// steps). Immutable once finished: it pins the recipe revision, the input
// versions and the environment it ran with.
model ExploreFlowRun {
  id                String    @id @default(cuid())
  flowId            String
  number            Int?      // #1, #2, ... per flow; null for trials
  trialNumber       Int?      // Trial 1, 2, ... per flow
  kind              String    // full | outOfDate | steps | trial
  flowRevisionId    String?
  recipeRevision    Int       @default(0)
  status            String    @default("queued") // queued | running | completed | failed | cancelled
  queuedAt          DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  startedById       String
  startedByMemberId String?
  startedByName     String?
  notifyOnFinish    Boolean   @default(false)
  stepCount         Int       @default(0)
  doneCount         Int       @default(0)
  currentAnalysisId String?
  failedAnalysisId  String?
  failedStepLabel   String?
  failureWords      String?
  failureDetail     String?
  plan              Json      // [{analysisId, label, name, revisionId, execute, dependsOn, reusedFrom}]
  inputs            Json      @default("[]") // [{alias, stepId, datasetId, versionId, versionNumber, contentHash, name}]
  environment       Json?     // {name, specHash, lockDigest, label, language, languageVersion, host}
  summary           Json?     // {headline, values}
  verification      Json?
  trialSample       Json?
  requestId         String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  flow      ExploreFlow          @relation(fields: [flowId], references: [id], onDelete: Cascade)
  stepRuns  ExploreAnalysisRun[]
  findings  ExploreRunFinding[]
  capsules  ExploreCapsule[]
  holds     ExploreRunHold[]

  @@unique([flowId, number])
  @@unique([flowId, trialNumber])
  @@index([flowId, createdAt])
  @@index([status])
}

// What the assistant proposed in the web client, in pencil until a person
// accepts or discards it. SeqDesk never calls a model; it only keeps these.
model ExploreStepProposal {
  id                  String   @id @default(cuid())
  flowId              String
  kind                String   // step | finding | gloss-rewrite | methods
  state               String   @default("pending") // pending | accepted | discarded
  afterAnalysisId     String?
  laneOf              String?
  position            String   @default("")
  canvas              Json?
  purpose             String   @default("")
  why                 String   @default("")
  assumes             Json     @default("[]")
  notChecked          Json     @default("[]")
  refusals            Json     @default("[]")
  inputs              Json     @default("[]")
  outputs             Json     @default("[]")
  code                String?
  language            String   @default("python")
  kitId               String?
  params              Json?
  values              Json?
  text                String?
  analysisId          String?  // methods: the step; gloss-rewrite: the gloss's step
  glossId             String?
  flowRunId           String?  // findings
  goal                String?
  origin              Json?
  requestedById       String
  requestedByMemberId String?
  activityId          String?
  acceptedById        String?
  acceptedAnalysisId  String?
  acceptedFindingId   String?
  discardReason       String?
  trialRunId          String?
  // Conversation provenance: the turn that proposed it, and its revisions after answers.
  proposedByTurnId    String?
  revision            Int      @default(1)
  revisedByTurnId     String?
  history             Json     @default("[]") // [{revision, assumes, why, purpose, revisedByTurnId, at}]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  flow ExploreFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, state])
}

// A note on one region of a step's code ("does", "because", "assumes",
// "chooses"). The region hash ties it to the code it explains.
model ExploreGloss {
  id           String    @id @default(cuid())
  analysisId   String
  revisionId   String
  lineStart    Int
  lineEnd      Int
  regionHash   String
  type         String    // does | because | assumes | chooses
  text         String
  author       String    // assistant | person
  state        String    @default("pencil") // pencil | accepted
  acceptedById String?
  acceptedAt   DateTime?
  checkStatus  String    @default("unchecked") // unchecked | passed | failed
  checkNotes   Json?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  analysis ExploreAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, regionHash])
  @@index([analysisId, revisionId])
}

// A finding a person accepted for a run: text whose numbers are live values.
model ExploreRunFinding {
  id           String   @id @default(cuid())
  flowRunId    String
  analysisId   String?
  text         String
  values       Json     @default("[]")
  caveats      Json     @default("[]")
  acceptedById String
  acceptedAt   DateTime @default(now())

  flowRun ExploreFlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId])
}

// Something that holds a run in place: a person's mark (a record check on the
// run or its values) or a Writer value reference pinned to it. The web client
// reports these, since they live on the collaboration server and in the Writer.
// While the current run has any, a newer run completes as "newer, not current".
model ExploreRunHold {
  id        String   @id @default(cuid())
  flowRunId String
  kind      String   // check | writer
  key       String   // the check key or the Writer value reference
  memberId  String?
  createdById String
  createdAt DateTime @default(now())

  flowRun ExploreFlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@unique([flowRunId, kind, key])
}

// A reproducible package of one output: code, input hashes, lock, README.
model ExploreCapsule {
  id           String    @id @default(cuid())
  flowRunId    String
  artifactId   String
  status       String    @default("building") // building | ready | failed
  path         String?
  size         BigInt?
  sha256       String?
  contents     Json      @default("[]")
  error        String?
  verifiedAt   DateTime?
  verification Json?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  flowRun ExploreFlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId, artifactId])
}

// Events and records waiting to be pushed to the collaboration server.
model ExploreEventOutbox {
  id            String    @id // idempotent: "<flowRunId>:finished", "<ref>@<updatedAt>"
  kind          String    // notebook-event | record
  target        String    // notebook | records
  authority     String
  workspaceId   String
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  deliveredAt   DateTime?
  failedAt      DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt, failedAt, nextAttemptAt])
}

model ExploreAnalysis {
  id                String   @id @default(cuid())
  targetKey         String
  name              String
  description       String?
  descriptionRevisionId String? // the code revision an assistant-written description was made from; null when a person wrote it
  kitId             String?  // template it was created from
  reportId          String?  // the report this analysis is a step of (SeqDesk's own report canvases)
  flowId            String?  // the flow this analysis is a step of (Flow canvases)
  slug              String?  // how the report cites this step (cohort_overview); fixed once given, survives renames
  language          String   // python | r
  environmentName   String
  currentRevisionId String?  @unique
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // Recipe placement (Flow): a fractional order key, lanes and groups.
  position          String   @default("")
  laneKind          String?  // alternative | forEach
  laneOf            String?
  laneLabel         String?
  groupId           String?
  purpose           String?  // one line, <= 200
  paramMeta         Json?    // {<key>: {label, unit, min, max, usual, options, meaning, consequence, phrase}}
  methodsSentence   Json?    // {text, tokens, revisionId, author, acceptedById, acceptedAt}
  proposedByTurnId  String?  // the conversation turn whose proposal became this step

  createdBy User                      @relation("ExploreAnalysisCreator", fields: [createdById], references: [id])
  report    ExploreReport?            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  flow      ExploreFlow?              @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversations ExploreStepConversation[]
  glosses   ExploreGloss[]
  revisions ExploreAnalysisRevision[]
  runs      ExploreAnalysisRun[]

  @@index([targetKey])
  @@index([reportId])
  @@index([flowId])
  @@index([createdById])
}

model ExploreAnalysisRevision {
  id           String   @id @default(cuid())
  analysisId   String
  number       Int
  code         String
  params       String   // JSON
  inputs       String   // JSON [{alias, datasetId, versionId}]
  fileInputs   String   @default("[]") // JSON [{alias, fileId}]; originals are immutable
  author       String   // user | agent
  authorUserId String?
  prompt       String?
  message      String?
  codeHash     String   @default("") // sha256 hex of the code
  createdAt    DateTime @default(now())

  analysis ExploreAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  runs     ExploreAnalysisRun[]

  @@unique([analysisId, number])
}

model ExploreAnalysisRun {
  id            String    @id @default(cuid())
  analysisId    String
  revisionId    String
  runNumber     String    @unique // EXP-20260904-001
  status        String    @default("pending") // pending | queued | running | completed | failed | cancelled
  executionMode String?   // local | slurm
  runFolder     String?
  queueJobId    String?
  queuedAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  exitCode      Int?
  outputTail    String?
  errorTail     String?
  results       String?   // JSON summary
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // A step of a numbered run of the whole recipe.
  flowRunId         String?
  stepLabel         String?
  trial             Boolean  @default(false)
  inputPins         Json?    // [{alias, datasetId, versionId, versionNumber, contentHash, name}]
  environmentDigest String?
  reusedFromRunId   String?
  durationMs        Int?

  flowRun   ExploreFlowRun?         @relation(fields: [flowRunId], references: [id], onDelete: SetNull)
  analysis  ExploreAnalysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  revision  ExploreAnalysisRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdBy User                    @relation("ExploreRunCreator", fields: [createdById], references: [id])
  artifacts ExploreArtifact[]

  @@index([analysisId, createdAt])
  @@index([status])
  @@index([flowRunId])
}

model ExploreArtifact {
  id               String   @id @default(cuid())
  runId            String
  kind             String   // figure | table | report | log
  format           String   // plotly-json | png | svg | html | tsv | md | txt
  name             String
  path             String
  size             BigInt?
  checksum         String?
  derivedDatasetId String?
  derivedVersionId String?
  createdAt        DateTime @default(now())

  run ExploreAnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, path])
}

// Private per-user step conversation and recoverable assistant checkpoint.
model ExploreStepConversation {
  analysisId String
  userId String
  version Int @default(0)
  state String @default("{}")
  updatedAt DateTime @updatedAt
  analysis ExploreAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  @@id([analysisId, userId])
}
