{
  "study": "RNA-seq: airway dexamethasone (GSE52778)",
  "flow": "Airway: dexamethasone response",
  "question": "Which genes does dexamethasone change in airway smooth muscle cells (4 cell lines, treated vs untreated)?",
  "tables": {
    "airway-counts": { "file": "airway_counts.csv", "sha256": "69d93e59052f921cea64b82f9b207aebde9d6b9532a9d12cdba4a06ad5391736", "roles": {} },
    "airway-samples": { "file": "airway_samples.csv", "sha256": "d044f4d8c9669819ae4ad823640b6bbf35026e3f3ff15b5210bd246d2ae19d82", "roles": { "sample": "sample", "group": "dex", "subject": "cell" } }
  },
  "steps": [
    {
      "key": "qc", "name": "Sample QC and filter", "file": "steps/01-qc-filter.R",
      "purpose": "Drop small libraries and genes too lowly expressed to test.",
      "inputs": { "counts": { "table": "airway-counts" }, "samples": { "table": "airway-samples" } },
      "params": { "min_library_size": 5000000, "group_column": "dex", "min_count": 10, "min_total_count": 15 },
      "packages": []
    },
    {
      "key": "pca", "name": "Normalise and PCA", "file": "steps/02-normalise-pca.R",
      "purpose": "Do samples separate by treatment or by cell line?",
      "inputs": { "counts_filtered": { "step": "qc", "output": "counts_filtered" }, "samples_qc": { "step": "qc", "output": "samples_qc" } },
      "params": { "colour_by": "dex", "shape_by": "cell", "n_top_genes": 500 },
      "packages": []
    },
    {
      "key": "de", "name": "DESeq2 treated vs untreated", "file": "steps/03-deseq2.R",
      "purpose": "Genes changed by dexamethasone, paired by cell line.",
      "inputs": { "counts_filtered": { "step": "qc", "output": "counts_filtered" }, "samples_qc": { "step": "qc", "output": "samples_qc" } },
      "params": { "design": "~ cell + dex", "factor": "dex", "numerator": "trt", "denominator": "untrt", "padj_cutoff": 0.05, "lfc_cutoff": 1 },
      "packages": []
    },
    {
      "key": "top", "name": "Top genes and heatmap", "file": "steps/04-top-genes.R",
      "purpose": "The strongest responders, per sample.",
      "inputs": { "de_results": { "step": "de", "output": "de_results" }, "counts_filtered": { "step": "qc", "output": "counts_filtered" }, "samples_qc": { "step": "qc", "output": "samples_qc" } },
      "params": { "n_top": 30, "annotate_by": ["dex", "cell"] },
      "packages": []
    }
  ]
}
