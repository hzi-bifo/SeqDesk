{
  "_comment": "Profile-neutral repository-development base. Copy to seqdesk.config.json, choose deployment.profile, and configure profile-specific operations after login. Installed releases use settings.json and default to port 8000.",

  "app": {
    "port": 3000,
    "accessAudience": "local"
  },

  "deployment": {
    "profile": "sequencing-center"
  },

  "site": {
    "name": "My SeqDesk",
    "dataBasePath": "./data/managed",
    "contactEmail": "admin@example.com"
  },

  "pipelines": {
    "enabled": false,
    "execution": {
      "mode": "local",
      "runDirectory": "./data/pipeline-runs",
      "conda": {
        "path": "/opt/conda",
        "environment": "seqdesk-pipelines"
      },
      "slurm": {
        "enabled": false,
        "queue": "cpu",
        "cores": 4,
        "memory": "64GB",
        "timeLimit": 12,
        "options": ""
      }
    }
  },

  "telemetry": {
    "enabled": false,
    "endpoint": "https://seqdesk.org/api/telemetry/heartbeat",
    "intervalHours": 24
  },

  "notifications": {
    "enabled": false,
    "provider": "seqdesk-relay",
    "relayUrl": "https://seqdesk.org/api/notifications/relay",
    "relayToken": ""
  },

  "runtime": {
    "databaseUrl": "postgresql://seqdesk:replace-with-local-db-password@127.0.0.1:5432/seqdesk?schema=public",
    "directUrl": "postgresql://seqdesk:replace-with-local-db-password@127.0.0.1:5432/seqdesk?schema=public",
    "nextAuthUrl": "http://localhost:3000",
    "nextAuthSecret": "",
    "anthropicApiKey": "",
    "adminSecret": "",
    "blobReadWriteToken": "",
    "updateServer": "https://seqdesk.org"
  }
}
